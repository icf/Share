        value = value[numberOfDependent:self.nbasis]
        vector = vector[:,numberOfDependent:self.nbasis]
        sqrtValue = np.sqrt(value)
        self.X = vector / sqrtValue
        self.XInv = vector.T * sqrtValue[:, None]
