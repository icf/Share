    # vhs0 = np.zeros((vhs1.shape[0], vhs1.shape[1], vhs1.shape[2]),dtype=np.complex128)
    # vhs.append(vhs0)
    vhs.append(vhs1)
    vhs.append(vhs1)
    print(f"{vhs1.shape = }")

    # time steps, 4 one body steps, 3 two body steps, ts_v is after sqrt
    ts_h = params['propagators_0']['ts_h']
